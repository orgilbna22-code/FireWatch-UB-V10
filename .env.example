# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ADMIN_TOKEN: Required Bearer token for write/admin endpoints
# (POST/PUT/DELETE /api/incidents, batch-sync, data-management).
# Leave unset or use a long random string; write endpoints fail closed if unset.
ADMIN_TOKEN="CHANGE_ME_GENERATE_RANDOM_ADMIN_TOKEN"

# ALLOWED_ORIGINS: Optional comma-separated CORS allowlist for /api/* routes.
ALLOWED_ORIGINS=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Gemini model overrides (defaults verified against @google/genai SDK)
GEMINI_MODEL="gemini-4-hydrogen"
GEMINI_FALLBACK_MODEL="gemini-3.1-flash-lite"
GEMINI_TIMEOUT_MS="18000"

# Persistent SQLite path (mount a persistent volume e.g. /data on Cloud Run/Fly/Render)
FIREWATCH_DB_PATH="./data/firewatch.sqlite"

# Optional external API base URL when hosting frontend separately on static hosting
VITE_API_BASE=""
